# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for durable cloud storage (Render/Neon/Supabase).
# If omitted in local dev, data persists in ./data/ombor-db.json with automatic rolling backups.
DATABASE_URL=""

# SESSION_SECRET: Secret key for signing auth session tokens (auto-generated on disk if omitted).
SESSION_SECRET=""

# PORT: Server HTTP/WS port (default 3000)
PORT="3000"

# VITE_API_URL: Optional backend API origin for standalone Capacitor iOS/Android builds (e.g. https://ombor-hvw6.onrender.com)
VITE_API_URL=""
